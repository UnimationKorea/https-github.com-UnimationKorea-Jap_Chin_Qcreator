# 서버 포트
PORT=8787

# ---- TTS 프로바이더 선택: mock | azure ----
# mock: API 키 없이 무음 WAV + 추정 타임스탬프 (오프라인 검증용 기본값)
# azure: Azure Speech REST로 실제 음성 합성 (키 필요)
TTS_PROVIDER=mock

# Azure Speech (TTS_PROVIDER=azure 일 때)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus

# ---- 강제정렬 프로바이더 선택: mock | whisper ----
# mock: 텍스트 길이 비례로 구간 분배 (오프라인 검증용 기본값)
# whisper: OpenAI Whisper API로 segment 타임스탬프 (키 필요)
ALIGN_PROVIDER=mock

# OpenAI Whisper (ALIGN_PROVIDER=whisper 일 때)
OPENAI_API_KEY=

# 오디오 클립 캐시 디렉터리
CACHE_DIR=.cache
